{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --disable-wasm-trap-handler --import ./src/worker/alias.js src/worker/index.js",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:demo": "node --import ./src/worker/alias.js db/demo/seedDemo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:cron": "node --disable-wasm-trap-handler --import ./src/worker/alias.js src/worker/cron.js",
    "start:passenger": "node server.cjs"
  },
  "dependencies": {
    "@slack/web-api": "^8.1.1",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "knex": "^3.3.0",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "next": "^16.3.7",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "vitest": "^5.0.2"
  }
}
