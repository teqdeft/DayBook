# .env.example  (copy to .env.local for development; never commit real values)

# App
NODE_ENV=development
APP_URL=http://localhost:3000          # public URL, used for Slack redirects and links
PORT=3000
LOG_LEVEL=info                          # debug | info | warn | error
TRUST_PROXY=false                       # true behind Nginx or a load balancer, so client IPs are read from X-Forwarded-For
DEFAULT_TIMEZONE=Asia/Kolkata           # used until Admin saves a time zone in Settings

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=daybook
DB_PASSWORD=change-me
DB_NAME=daybook
DB_POOL_MIN=2
DB_POOL_MAX=10
# Optional: a separate admin user for migrations (falls back to DB_USER / DB_PASSWORD)
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# Sessions
SESSION_SECRET=generate-64-random-characters   # signs and hashes session tokens
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=daybook_session

# Slack: Sign in with Slack (OpenID Connect)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=                          # only this workspace may sign in

# Slack: bot for posting reports and messages
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=                   # not used in Phase 1; reserved for slash commands

# First admin, created by the seed
SEED_ADMIN_EMAIL=ceo@company.com
SEED_ADMIN_NAME=CEO Name

# Desktop notifications (Web Push). Generate a pair once per environment with:
#   npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key stays secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourcompany.com   # who push services can contact about this app

# Worker
WORKER_CRON_ENABLED=true                # set false on extra web servers so jobs run once

# Local development only: shows "Sign in as" on /login without Slack. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false
